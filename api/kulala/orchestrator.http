Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "customerId": "{{CUSTOMER_ID}}",
  "clusterId": "{{CLUSTER_ID}}"
}

# ExecuteEmergencyChange / ReleaseEmergencyLock are careful writes: build the
# workload_ref ("deployments/<ns>/<name>") and confirm the target first.

# =============================================================================
# CleanupService — destructive maintenance, no read-only RPCs
# =============================================================================

# Both RPCs change data and are platform_admin-only (the `cleanup` object has no
# non-wildcard grant), so they are listed rather than pre-filled:
#   POST {{ORCHESTRATOR_URL}}/orchestrator.v1.CleanupService/RunCleanup       {"retentionDays": 90}
#   POST {{ORCHESTRATOR_URL}}/orchestrator.v1.CleanupService/UnarchiveBundle  {"bundleId": "..."}

# =============================================================================
# BundleService — bundle reads; ingress is a service-identity path
# =============================================================================

### ListBundles
# @name ListBundles
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.BundleService/ListBundles
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "releaseDefinitionId": "{{DEFINITION_ID}}",
  "pagination": {"pageSize": 20}
}

### GetBundle
# @name GetBundle
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.BundleService/GetBundle
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "bundleId": "{{BUNDLE_ID}}",
  "releaseDefinitionId": "{{DEFINITION_ID}}"
}

# SubmitBundle (TASK-102: CI API key) and RecordArtifactEvent (Harbor key) are
# service-identity ingress paths, not console reads; see webhook.http for the CI
# entrypoint and docs/api.md §3.3 for the credential matrix.

# =============================================================================
# TrustService
# =============================================================================

### GetTrustPolicy
# @name GetTrustPolicy
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/trust.v1.TrustService/GetTrustPolicy
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "environment": "{{TRUST_ENVIRONMENT}}"
}

# CreateTrustRoot / RotateTrustRoot / EndGrace / RetireTrustRoot /
# RevokeTrustRoot are platform_admin-only trust-root writes (REQ-043).
