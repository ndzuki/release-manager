# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
coverage.out
coverage.html

# Dependency directories
vendor/

# Proto generated files

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Certificates (generated by scripts/generate-certs.sh)
certs/

# Data directory (SQLite databases etc.)
data/

# E2E runner artifacts (baseline/run/stage JSON; uploaded by CI, never source)
e2e-results/

# Helm chart packages
*.tgz

# Stray root-level service binaries from ad-hoc `go build ./cmd/<svc>` runs (the
# Makefile builds into bin/). `auth` and `webhook` were committed this way once.
# Patterns are root-anchored cmd/ basenames; `api` is deliberately absent because a
# bare `api` pattern would also match the tracked api/ directory.
/auth
/devseed
/e2e
/imagecheck
/installgate
/notification-sink
/notifier
/operator
/orchestrator
/reqcheck
/sdkcheck
/store-migrate
/webhook

# Temporary files
/tmp/
/tmp-*/

# .env
.env
# Local environment files must never be committed, at any depth; `.env.example`
# is the committable template that documents the expected keys.
.env.*
!.env.example

# No chart-tarball rule needed: `*.tgz` above already ignores archives at any depth.
# The path this rule used to name (`test/e2e/testdata/`) never existed - the Helm chart
# archives the SDK integration tests use are created inside `t.TempDir()`, outside the
# work tree - so the rule ignored nothing but a guess.
release-*
/sdkcheck
/reqcheck
core.*
