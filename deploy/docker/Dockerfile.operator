FROM golang:1.27.2@sha256:2d658507a011f1eadc0114d7a421b312b2e77d9042a24036a26e267cc9231677 AS builder
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-operator ./cmd/operator

FROM gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-operator /release-operator
EXPOSE 8084
ENTRYPOINT ["/release-operator"]
CMD ["--config", "/configs/operator.dev.yaml", "--db", "/data/operator.db", "--command-db", "/data/operator-commands.db"]
