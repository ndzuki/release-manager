FROM golang:1.26.4@sha256:f96cc555eb8db430159a3aa6797cd5bae561945b7b0fe7d0e284c63a3b291609 AS builder
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-operator ./cmd/operator

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-operator /release-operator
EXPOSE 8084
ENTRYPOINT ["/release-operator"]
CMD ["--config", "/configs/operator.dev.yaml", "--db", "/data/operator.db", "--command-db", "/data/operator-commands.db"]
