FROM golang:1.27.3@sha256:1ad9754cfcca40bdb57424ff4ad9ca754f5d5e4660944a9b266da90f8a6853a5 AS builder
# GOPROXY build-arg: dev.sh injects the host's `go env GOPROXY`; the image's
# built-in default (proxy.golang.org) is unreachable from CN hosts. Without
# this ARG the --build-arg is silently dropped for THIS image only (every other
# Go Dockerfile declares it), so `go mod download` dials proxy.golang.org and
# dies with `dial tcp …:443: i/o timeout` after ~6 minutes — the 2026-09-24
# `docker_build_failed: build failed for release-api`.
ARG GOPROXY
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-api ./cmd/api

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-api /release-api
COPY configs/api.dev.yaml /configs/api.dev.yaml
# 8088, not 8087: 8087 is the web SPA in the dev environment (the Kustomize
# Deployment mounts its own config over the baked copy and sets the container
# port). EXPOSE is documentation only, but a wrong port here is a wrong
# statement — REQ-065 D2.
EXPOSE 8088
ENTRYPOINT ["/release-api", "--config", "/configs/api.dev.yaml", "--db", "/data/api.db"]
