# =============================================================================
# Release Manager — Harbor Webhook Simulation
# Environment: dev (Manager :8081)
#
# Simulate Harbor PUSH_HELMCHART / PUSH_ARTIFACT events.
# HMAC-SHA256 signature is generated by Harbor; use a pre-computed signature
# for manual testing or set HARBOR_SECRET and let the pre-request script
# compute it (requires kulala JS pre-request hook).
# =============================================================================

### Harbor PUSH_HELMCHART — Ingress Controller
# @name HarborPushHelm
POST {{BASE_URL}}/api/v1/webhook/harbor
Content-Type: application/json
Authorization: Harbor-Signature {{harbor_signature}}

{
  "type": "PUSH_HELMCHART",
  "occur_at": 1718000000,
  "operator": "harbor-robot",
  "event_data": {
    "resources": [
      {
        "digest": "sha256:def456",
        "tag": "{{CHART_VERSION}}",
        "resource_url": "{{CHART_REF}}:{{CHART_VERSION}}"
      }
    ],
    "repository": {
      "name": "{{RELEASE_NAME}}",
      "namespace": "library",
      "repo_full_name": "library/{{RELEASE_NAME}}",
      "repo_type": "helm-chart"
    }
  }
}

### Harbor PUSH_ARTIFACT — Image
# @name HarborPushImage
POST {{BASE_URL}}/api/v1/webhook/harbor
Content-Type: application/json
Authorization: Harbor-Signature {{harbor_signature}}

{
  "type": "PUSH_ARTIFACT",
  "occur_at": 1718000100,
  "operator": "harbor-robot",
  "event_data": {
    "resources": [
      {
        "digest": "{{IMAGE_DIGEST}}",
        "tag": "v2.0.0",
        "resource_url": "harbor.example.com/library/{{RELEASE_NAME}}:v2.0.0"
      }
    ],
    "repository": {
      "name": "{{RELEASE_NAME}}",
      "namespace": "library",
      "repo_full_name": "library/{{RELEASE_NAME}}",
      "repo_type": "image"
    }
  }
}

### Harbor PUSH_ARTIFACT — Invalid Signature
# @name HarborPushInvalidSig
POST {{BASE_URL}}/api/v1/webhook/harbor
Content-Type: application/json
Authorization: Harbor-Signature INVALID_SIGNATURE_FOR_TESTING

{
  "type": "PUSH_ARTIFACT",
  "occur_at": 1718000200,
  "event_data": {
    "resources": [{"digest": "sha256:bad", "tag": "v1.0.0", "resource_url": "harbor.example.com/malicious:v1.0.0"}],
    "repository": {"name": "malicious", "repo_full_name": "harbor/malicious", "repo_type": "image"}
  }
}

### Submit ReleaseBundle (CI)
# @name SubmitBundle
POST {{BASE_URL}}/api/v1/artifact-events/harbor
Content-Type: application/json

{
  "chart": {
    "ref": "{{CHART_REF}}",
    "version": "{{CHART_VERSION}}",
    "digest": "sha256:chartdef456"
  },
  "images": [
    {
      "values_path": "image.repository",
      "ref": "harbor.example.com/library/{{RELEASE_NAME}}",
      "digest": "{{IMAGE_DIGEST}}"
    }
  ],
  "source": {
    "git_commit": "abc123def456",
    "pipeline_id": "998877"
  },
  "provenance": {
    "signature_ref": "cosign://...",
    "sbom_ref": "spdx://..."
  }
}
