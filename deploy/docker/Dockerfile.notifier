FROM golang:1.26.4 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-notifier ./cmd/notifier

FROM gcr.io/distroless/static-debian13:nonroot
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-notifier /release-notifier
COPY configs/notifier.dev.yaml /configs/notifier.dev.yaml
EXPOSE 8086
ENTRYPOINT ["/release-notifier", "--config", "/configs/notifier.dev.yaml", "--db", "/data/notifier.db"]
