FROM golang:1.27.1@sha256:f44f6e88636cfb311f9ebace870ded69d943f227bb3cb27d32ffd84ea18c43ea AS builder
# GOPROXY build-arg: dev.sh injects the host's go env GOPROXY; the default
# proxy.golang.org is unreachable from CN hosts.
ARG GOPROXY
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-notification-sink ./cmd/notification-sink

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-notification-sink /release-notification-sink
ENTRYPOINT ["/release-notification-sink", "--config", "/configs/notification-sink.dev.yaml"]
