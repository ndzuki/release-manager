        "/api/v1/init": {
            "get": {
                "description": "检查系统是否已完成首次初始化",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "初始化"
                ],
                "summary": "查询初始化状态",
                "responses": {
                    "200": {
                        "description": "初始化状态",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "description": "首次初始化系统，创建管理员用户（仅未初始化时可用）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "初始化"
                ],
                "summary": "创建管理员账号",
                "parameters": [
                    {
                        "description": "管理员信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "type": "string"
                                },
                                "password": {
                                    "type": "string"
                                },
                                "username": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "初始化成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "参数校验失败",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "409": {
                        "description": "系统已初始化",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/releases/{requestId}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "根据请求 ID 查询发布状态记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "发布管理"
                ],
                "summary": "查询发布记录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "请求 ID",
                        "name": "requestId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "发布记录列表",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_manager.ReleaseRecord"
                            }
                        }
                    },
                    "500": {
                        "description": "内部错误",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/webhook/harbor": {
            "post": {
                "security": [
                    {
                        "HmacSignature": []
                    }
                ],
                "description": "处理 Harbor PUSH_HELMCHART 事件，验证 HMAC 签名并转发到客户集群",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Webhook"
                ],
                "summary": "接收 Harbor webhook",
                "parameters": [
                    {
                        "description": "Harbor webhook 载荷",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_manager.HarborWebhookPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "处理成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "无效请求",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "处理失败",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_manager.AuditLogEntry": {
            "type": "object",
            "required": [
                "action",
                "client_ip",
                "duration_ms",
                "id",
                "method",
                "org_id",
                "path",
                "req_body_snippet",
                "resource",
                "resource_id",
                "status_code",
                "timestamp",
                "user_agent",
                "user_id",
                "username"
            ],
            "properties": {
                "action": {
                    "description": "操作类型（HTTP method）",
                    "type": "string"
                },
                "client_ip": {
                    "description": "客户端 IP",
                    "type": "string"
                },
                "duration_ms": {
                    "description": "请求处理耗时（毫秒）",
                    "type": "integer"
                },
                "id": {
                    "description": "自增主键",
                    "type": "integer"
                },
                "method": {
                    "description": "HTTP method",
                    "type": "string"
                },
                "org_id": {
                    "description": "所属组织 ID",
                    "type": "string"
                },
                "path": {
                    "description": "请求路径",
                    "type": "string"
                },
                "req_body_snippet": {
                    "description": "请求体摘要（截断至 256 字符）",
                    "type": "string"
                },
                "resource": {
                    "description": "目标资源类型（customer, release, user, chart 等）",
                    "type": "string"
                },
                "resource_id": {
                    "description": "目标资源 ID",
                    "type": "string"
                },
                "status_code": {
                    "description": "HTTP 响应状态码",
                    "type": "integer"
                },
                "timestamp": {
                    "description": "请求时间",
                    "type": "string"
                },
                "user_agent": {
                    "description": "User-Agent",
                    "type": "string"
                },
                "user_id": {
                    "description": "操作人 ID（匿名请求为 \"anonymous\"）",
                    "type": "string"
                },
                "username": {
                    "description": "操作人名称",
                    "type": "string"
                }
            }
        },
        "internal_manager.Customer": {
            "type": "object",
            "required": [
                "cert_fingerprint",
                "created_at",
                "enabled",
                "id",
                "name",
                "operator_endpoint",
                "updated_at"
            ],
            "properties": {
                "cert_fingerprint": {
                    "description": "mTLS 客户端证书 SHA256 指纹",
                    "type": "string",
                    "example": "ABCDEF123456..."
                },
                "created_at": {
                    "description": "创建时间",
                    "type": "string"
                },
                "enabled": {
                    "description": "是否启用自动更新",
                    "type": "boolean",
                    "example": true
                },
                "id": {
                    "description": "客户唯一标识",
                    "type": "string",
                    "example": "customer-001"
                },
                "labels": {
                    "description": "客户标签（分组/筛选）",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "description": "客户名称",
                    "type": "string",
                    "example": "某客户"
                },
                "operator_endpoint": {
                    "description": "release-operator gRPC 地址",
                    "type": "string",
                    "example": "10.0.0.5:8443"
                },
                "updated_at": {
                    "description": "更新时间",
                    "type": "string"
                }
            }
        },
        "internal_manager.HarborRepository": {
            "type": "object",
            "required": [
                "name",
                "namespace",
                "repo_full_name",
                "repo_type"
            ],
            "properties": {
                "name": {
                    "description": "如 \"helm/magic-sandbox\"",
                    "type": "string"
                },
                "namespace": {
                    "description": "项目名",
                    "type": "string"
                },
                "repo_full_name": {
                    "description": "如 \"library/helm/magic-sandbox\"",
                    "type": "string"
                },
                "repo_type": {
                    "description": "仓库类型，\"CHART\"",
                    "type": "string"
                }
            }
        },
        "internal_manager.HarborResource": {
            "type": "object",
            "required": [
                "digest",
                "resource_url",
                "tag"
            ],
            "properties": {
                "digest": {
                    "description": "内容摘要",
                    "type": "string"
                },
                "labels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "resource_url": {
                    "description": "OCI 资源 URL",
                    "type": "string"
                },
                "tag": {
                    "description": "chart 版本号",
                    "type": "string"
                }
            }
        },
        "internal_manager.HarborWebhookPayload": {
            "type": "object",
            "required": [
                "event_data",
                "occur_at",
                "operator",
                "type"
            ],
            "properties": {
                "event_data": {
                    "type": "object",
                    "required": [
                        "repository",
                        "resources"
                    ],
                    "properties": {
                        "repository": {
                            "description": "仓库元数据",
                            "allOf": [
                                {
                                    "$ref": "#/definitions/internal_manager.HarborRepository"
                                }
                            ]
                        },
                        "resources": {
                            "description": "推送的 chart 资源列表",
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_manager.HarborResource"
                            }
                        }
                    }
                },
                "occur_at": {
                    "description": "事件发生时间（Unix 时间戳）",
                    "type": "integer"
                },
                "operator": {
                    "description": "操作者",
                    "type": "string"
                },
                "type": {
                    "description": "事件类型，如 \"PUSH_HELMCHART\"",
                    "type": "string"
                }
            }
        },
        "internal_manager.ReleaseRecord": {
            "type": "object",
            "required": [
                "chart_name",
                "chart_version",
                "completed_at",
                "customer_id",
                "duration_secs",
                "error_message",
                "id",
                "request_id",
                "started_at",
                "status"
            ],
            "properties": {
                "chart_name": {
                    "description": "Helm chart 名称",
                    "type": "string"
                },
                "chart_version": {
                    "description": "chart 版本",
                    "type": "string"
                },
                "completed_at": {
                    "description": "完成时间",
                    "type": "string"
                },
                "customer_id": {
                    "description": "客户 ID",
                    "type": "string"
                },
                "duration_secs": {
                    "description": "操作耗时（秒）",
                    "type": "integer"
                },
                "error_message": {
                    "description": "错误信息",
                    "type": "string"
                },
                "id": {
                    "description": "记录 ID",
                    "type": "string"
                },
                "request_id": {
                    "description": "请求 ID",
                    "type": "string"
                },
                "started_at": {
                    "description": "开始时间",
                    "type": "string"
                },
                "status": {
                    "description": "发布状态",
                    "type": "string"
                }
            }
        },
        "internal_manager.UpdateCustomerRequest": {
            "type": "object",
            "properties": {
                "cert_fingerprint": {
                    "description": "证书指纹",
                    "type": "string"
                },
                "enabled": {
                    "description": "是否启用",
                    "type": "boolean"
                },
                "labels": {
                    "description": "客户标签",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "name": {
                    "description": "客户名称",
                    "type": "string"
                },
                "operator_endpoint": {
                    "description": "operator gRPC 地址",
