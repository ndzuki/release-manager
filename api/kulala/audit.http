# =============================================================================
# Release Manager — Audit Collection API
# Environment: orchestrator :8083
# =============================================================================

### Emit API key and service audit events
# @name EmitAudit
POST http://localhost:8083/audit.v1.AuditService/Emit
Content-Type: application/json

{
  "events": [
    {
      "actor": {
        "kind": "ACTOR_KIND_API_KEY",
        "id": "key-ci-release",
        "organizationId": "org-001"
      },
      "resourceType": "release",
      "resourceId": "release-001",
      "action": "update",
      "status": "accepted",
      "changeSummary": "password=must-not-persist",
      "metadata": {
        "token": "must-not-persist",
        "request_id": "req-001"
      }
    },
    {
      "actor": {
        "kind": "ACTOR_KIND_SERVICE",
        "id": "release-orchestrator"
      },
      "resourceType": "operation",
      "resourceId": "op-001",
      "action": "create",
      "status": "accepted"
    }
  ]
}

### Health
GET http://localhost:8083/health
