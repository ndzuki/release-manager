# DEV_DOCKER_MIRROR build-args: dev.sh forwards the host's container-image
# mirror prefix when Docker Hub is unreachable (CN hosts); empty = official
# tags (CI default). FROM supports ARG substitution for the base image.
ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NODE_IMAGE} AS builder
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM ${NGINX_IMAGE}
COPY --from=builder /app/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8087
