{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["customerID"],
  "properties": {
    "customerID": {
      "type": "string",
      "minLength": 1,
      "description": "客户唯一标识（必填）"
    },
    "notificationEndpoint": {
      "type": "string",
      "description": "release-manager 的 gRPC 地址"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "grpc": {
      "type": "object",
      "properties": {
        "addr": { "type": "string" },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "cert": { "type": "string" },
        "key": { "type": "string" },
        "ca": { "type": "string" },
        "existingCertSecret": { "type": "string" },
        "existingCaSecret": { "type": "string" }
      }
    },
    "harbor": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "insecureSkipVerify": { "type": "boolean" },
        "timeout": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "helm": {
      "type": "object",
      "properties": {
        "upgradeTimeout": { "type": "string" },
        "defaultNamespace": { "type": "string" },
        "maxHistory": { "type": "integer", "minimum": 1 },
        "atomic": { "type": "boolean" },
        "wait": { "type": "boolean" },
        "createNamespace": { "type": "boolean" },
        "cacheDir": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "managedNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer" },
        "fsGroup": { "type": "integer" }
      }
    }
  }
}
