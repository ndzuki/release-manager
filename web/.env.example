# web/.env.example — 前端运行时环境变量示例（全部来自源码真实读取点）
#
# 用法：
#   cp web/.env.example web/.env.local   # 按需改值
# `VITE_*` 由 Vite/Vitest 按 .env 约定自动加载（.env.local 优先级高于 .env）。
# 注意：web/.env.local 被 web/.gitignore:3 的 `*.local` 忽略；根 .gitignore:66 只忽略
#       `.env` 本身——不要把真实值写进 `.env.development` / `.env.production`（不被忽略）。
#
# 每个键在代码中的读取位置见行内注释；类型声明见 web/env.d.ts:3-13。
# 所有开关的判定语义都是 `!== 'false'`：默认启用，只有精确字符串 false 才关闭。

# Connect transport 的 base URL。默认空串 = 同源相对路径（dev 走 vite.config.ts:27-59 的
# 代理，容器走 web/nginx.conf 反代）。仅在跨源部署时填写后端 origin。
# 读取：web/src/connect/client.ts:51
VITE_API_BASE=

# ReleaseInventory 路由开关（/customers/:id/clusters/:id/releases）。
# 读取：web/src/router/index.ts:7
VITE_ENABLE_RELEASE_INVENTORY=true

# ValuesRevision 编辑路由与表格入口开关。
# 读取：web/src/router/index.ts:8、web/src/components/releases/ReleaseInventoryTable.vue:16
VITE_ENABLE_VALUES_REVISION=true

# 发布操作（Operation 创建/详情）路由与入口开关。
# 读取：web/src/router/index.ts:9、185、web/src/pages/ReleaseInventoryPage.vue:24
VITE_ENABLE_RELEASE_OPERATIONS=true

# 集群路由（cluster routing）导航入口开关。
# 读取：web/src/components/common/AppShell.vue:11、web/src/router/index.ts:179
VITE_FEATURE_CLUSTER_ROUTING=true

# Operator 管理入口开关。
# 读取：web/src/pages/ClusterDetailPage.vue:17、web/src/router/index.ts:182
VITE_FEATURE_OPERATOR_MANAGEMENT=true

# 制品缓存端点展示值；未设置时代码回退为 'cache.local'。
# 读取：web/src/pages/ClusterDetailPage.vue:19、web/src/pages/ClusterEditPage.vue:20
VITE_ARTIFACT_CACHE_ENDPOINT=cache.local

# 制品 registry 端点展示值；未设置时代码回退为 'registry.local'。
# 读取：web/src/pages/ClusterDetailPage.vue:20、web/src/pages/ClusterEditPage.vue:21
VITE_ARTIFACT_REGISTRY_ENDPOINT=registry.local

# OperationDetail 实时刷新（轮询/流式更新）开关。
# 读取：web/src/pages/OperationDetailPage.vue:32
VITE_OPERATION_LIVE_UPDATES=true

# ---------------------------------------------------------------------------
# 以下变量不是 Vite 运行时变量：它们是 Playwright（node 进程）通过 process.env
# 读取的，npm run test:e2e 不会从本文件自动加载——请在 shell 中 export。
# ---------------------------------------------------------------------------

# 打开真实后端浏览器 E2E 的显式开关；非 'true' 时整个 suite skip。
# 读取：web/e2e/emergency-smoke.spec.ts:14
# E2E_BACKEND=true

# Playwright baseURL，默认 http://127.0.0.1:5173。
# 读取：web/playwright.config.ts:17
# E2E_BASE_URL=http://127.0.0.1:5173

# E2E 双管理员账号（第二浏览器上下文用于异人审批）。密码无默认值（空串）。
# 读取：web/e2e/emergency-smoke.spec.ts:20-21
# E2E_ADMIN_A_USER=admin-a
# E2E_ADMIN_A_PASS=
# E2E_ADMIN_B_USER=admin-b
# E2E_ADMIN_B_PASS=

# 路由进入 → 表单可操作的 TTI 断言预算（毫秒），默认 1500。
# 读取：web/e2e/emergency-smoke.spec.ts:28
# E2E_TTI_BUDGET_MS=1500
