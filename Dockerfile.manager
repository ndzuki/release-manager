# =============================================================================
# release-manager Docker 镜像
#
# 本地开发: 先用 go build 编译二进制，再 COPY 进镜像（避免 Docker build 内 Go 版本不匹配）
# 生产 CI:  可改为多阶段构建，使用与 go.mod 匹配的 golang 镜像
# =============================================================================
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

# 本地编译的二进制文件
# 构建方式: CGO_ENABLED=0 go build -ldflags="-s -w" -o bin/release-manager ./cmd/release-manager/
COPY bin/release-manager /usr/local/bin/release-manager

RUN mkdir -p /data && adduser -D -s /bin/sh -h /data release-manager
USER release-manager
WORKDIR /data

EXPOSE 8080 8443

ENTRYPOINT ["release-manager"]
