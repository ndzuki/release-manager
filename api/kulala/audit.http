# =============================================================================
# Release Manager — Audit Query & Export APIs
# Environment: release-api :8087
# =============================================================================

@BASE_URL = http://localhost:8087
@AUDIT_CONNECT = {{BASE_URL}}/audit.v1.AuditService

### Query Audit Events
# @name QueryAuditEvents
POST {{AUDIT_CONNECT}}/QueryAuditEvents
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "filter": {
    "resource_type": "release_operation",
    "action": "create",
    "time_range": {
      "start": "2026-07-01T00:00:00Z",
      "end": "2026-07-15T00:00:00Z"
    }
  },
  "pagination": {
    "page_size": 20,
    "page_token": ""
  }
}

### Export Audit Events
# @name ExportAuditEvents
POST {{AUDIT_CONNECT}}/ExportAuditEvents
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "filter": {
    "time_range": {
      "start": "2026-07-01T00:00:00Z",
      "end": "2026-07-15T00:00:00Z"
    }
  }
}

### Emit Audit Event
# @name EmitAuditEvent
POST {{AUDIT_CONNECT}}/Emit
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "events": [
    {
      "actor": {
        "kind": "ACTOR_KIND_USER",
        "id": "user-001",
        "organization_id": "org-001",
        "role": "release_admin"
      },
      "resource_type": "release_operation",
      "resource_id": "operation-001",
      "action": "create",
      "status": "accepted",
      "metadata": {
        "source": "kulala"
      }
    }
  ]
}
