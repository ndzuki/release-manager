# =============================================================================
# Release Manager — Operator gRPC endpoints (Kulala GRPC support)
# Environment: dev (Operator gRPC :8447)
#
# @grpc-plaintext        ← REQUIRED: server has no TLS
#
# gRPC service: operator.v1.OperatorService
# =============================================================================

### Operator — Enroll
# @name OperatorEnroll
GRPC {{OP_GRPC_HOST}}:{{OP_GRPC_PORT}} operator.v1.OperatorService/Enroll
Content-Type: application/grpc

{
  "operator_id": "{{OPERATOR_NAME}}",
  "cluster_id": "{{CLUSTER_NAME}}",
  "capabilities": {
    "helm": "v3",
    "preflight": "true"
  }
}

### Operator — Health Check
# @name OperatorHealth
GRPC {{OP_GRPC_HOST}}:{{OP_GRPC_PORT}} grpc.health.v1.Health/Check
Content-Type: application/grpc

{}

### Operator — Enroll (missing cluster)
# Expected: some error
# @name EnrollMissingCluster
GRPC {{OP_GRPC_HOST}}:{{OP_GRPC_PORT}} operator.v1.OperatorService/Enroll
Content-Type: application/grpc

{
  "operator_id": "test-op",
  "cluster_id": "",
  "capabilities": {}
}
