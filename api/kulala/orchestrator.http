# =============================================================================
# release-orchestrator — Connect collection (ADR-002 single-port contract)
#
#   make api-check          validate every path below against api/proto
#   make api-orchestrator   open this file (nvim) — see docs/http-collections.md
#
# Mounted services on this listener:
#   orchestrator.v1.OrchestratorService, orchestrator.v1.CleanupService,
#   orchestrator.v1.BundleService, trust.v1.TrustService
#
# Everything needs `Authorization: Bearer {{AUTH_TOKEN}}` from auth.http's Login.
# Ids below are placeholders: replace them with a value from the list requests in
# this file (or from `make dev-seed`'s fixture output in data/dev-fixture.json).
# =============================================================================

@CUSTOMER_ID = 00000000-0000-0000-0000-000000000000
@CLUSTER_ID = 00000000-0000-0000-0000-000000000000
@DEFINITION_ID = 00000000-0000-0000-0000-000000000000
@OPERATION_ID = 00000000-0000-0000-0000-000000000000
@BUNDLE_ID = 00000000-0000-0000-0000-000000000000
@ORGANIZATION_ID = 00000000-0000-0000-0000-000000000000

# =============================================================================
# OrchestratorService — customer / cluster / definition inventory
# =============================================================================

### ListCustomers
# @name ListCustomers
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/ListCustomers
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "includeDisabled": false
}

> {%
  if (response.body.customers && response.body.customers.length > 0) {
    client.global.set("CUSTOMER_ID", response.body.customers[0].id);
  }
%}

### ListClusters
# @name ListClusters
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/ListClusters
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "customerId": "{{CUSTOMER_ID}}"
}

### ListReleaseDefinitions
# @name ListReleaseDefinitions
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/ListReleaseDefinitions
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "customerId": "{{CUSTOMER_ID}}",
  "clusterId": "{{CLUSTER_ID}}",
  "includeDisabled": false
}

### GetReleaseDefinition
# @name GetReleaseDefinition
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/GetReleaseDefinition
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "definitionId": "{{DEFINITION_ID}}"
}

### GetClusterRoutes
# @name GetClusterRoutes
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/GetClusterRoutes
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "clusterId": "{{CLUSTER_ID}}"
}

# =============================================================================
# OrchestratorService — operators and enrollment
# =============================================================================

### ListOperators
# @name ListOperators
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/ListOperators
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "customerId": "{{CUSTOMER_ID}}",
  "clusterId": "{{CLUSTER_ID}}",
  "pageSize": 20
}

### GetOperator
# @name GetOperator
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/GetOperator
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "operatorId": "00000000-0000-0000-0000-000000000000"
}

### GetEnrollmentTokenStatus
# @name GetEnrollmentTokenStatus
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/GetEnrollmentTokenStatus
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "tokenId": "00000000-0000-0000-0000-000000000000"
}

# Writes on this service (need a fresh body; several are destructive):
#   CreateCustomer / UpdateCustomer / DisableCustomer
#   CreateCluster / UpdateCluster / DisableCluster
#   CreateReleaseDefinition / UpdateReleaseDefinition / DisableReleaseDefinition
#   CreateEnrollmentToken / RevokePendingEnrollmentToken / RevokeOperator
#   ConfigureClusterRoute / DeleteClusterRoute

# =============================================================================
# OrchestratorService — operations (TASK-095 implemented ListOperations)
# =============================================================================

### ListOperations
# @name ListOperations
# @kulala-expect-status-code 200
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/ListOperations
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "releaseDefinitionId": "{{DEFINITION_ID}}",
  "limit": 20
}

### GetOperation
# @name GetOperation
POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/GetOperation
Content-Type: application/json
Authorization: Bearer {{AUTH_TOKEN}}

{
  "operationId": "{{OPERATION_ID}}"
}

# CreateOperation (INSTALL/UPGRADE) needs Idempotency-Key plus a bundleId and
# valuesRevisionId; RollbackRelease / CancelOperation / PublishRelease are writes.
#   POST {{ORCHESTRATOR_URL}}/orchestrator.v1.OrchestratorService/CreateOperation
#   Idempotency-Key: <uuid>
#   {"operationType": "INSTALL", "releaseDefinitionId": "...", "bundleId": "...", "valuesRevisionId": "..."}

