FROM golang:1.26.4 AS builder
# GOPROXY build-arg: dev.sh injects the host's go env GOPROXY; the default
# proxy.golang.org is unreachable from CN hosts.
ARG GOPROXY
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-orchestrator ./cmd/orchestrator

FROM gcr.io/distroless/static-debian13:nonroot
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-orchestrator /release-orchestrator
EXPOSE 8083
ENTRYPOINT ["/release-orchestrator", "--config", "/configs/orchestrator.dev.yaml", "--db", "/data/release-manager.db"]
