FROM golang:1.26.4@sha256:f96cc555eb8db430159a3aa6797cd5bae561945b7b0fe7d0e284c63a3b291609 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-api ./cmd/api

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-api /release-api
COPY configs/api.dev.yaml /configs/api.dev.yaml
EXPOSE 8087
ENTRYPOINT ["/release-api", "--config", "/configs/api.dev.yaml", "--db", "/data/api.db"]
