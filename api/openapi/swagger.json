                    }
                ],
                "description": "根据客户 ID 获取客户信息\n更新指定客户的信息（支持部分更新）\n从白名单中移除指定客户",
                "consumes": [
                    "application/json",
                    "application/json",
                    "application/json"
                ],
                "produces": [
                    "application/json",
                    "application/json",
                    "application/json"
                ],
                "tags": [
                    "客户管理",
