FROM golang:1.27.3@sha256:1ad9754cfcca40bdb57424ff4ad9ca754f5d5e4660944a9b266da90f8a6853a5 AS builder
# GOPROXY build-arg: dev.sh injects the host's go env GOPROXY; the default
# proxy.golang.org is unreachable from CN hosts.
ARG GOPROXY
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-webhook ./cmd/webhook

FROM gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-webhook /release-webhook
EXPOSE 8082
# Args come from the Kustomize Deployment (config path + env); the historical
# --db flag was removed upstream (config-file database.driver), so the
# ENTRYPOINT must not pass it — the flag package rejects unknown flags.
ENTRYPOINT ["/release-webhook"]
