FROM golang:1.27.3@sha256:1ad9754cfcca40bdb57424ff4ad9ca754f5d5e4660944a9b266da90f8a6853a5 AS builder
# GOPROXY build-arg: dev.sh injects the host's go env GOPROXY; the default
# proxy.golang.org is unreachable from CN hosts.
ARG GOPROXY
ENV GOPROXY=$GOPROXY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/release-auth ./cmd/auth

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
USER nonroot:nonroot
WORKDIR /data
COPY --from=builder /out/release-auth /release-auth
EXPOSE 8085
# Args come from the Kustomize Deployment (config path + env); the historical
# --db flag was removed upstream (config-file database.driver), so the
# ENTRYPOINT must not pass it — the flag package rejects unknown flags.
ENTRYPOINT ["/release-auth"]
